{
  "name": "smart-dashboard-server",
  "version": "0.1.0",
  "private": true,
  "description": "API et console web du Smart Personal Dashboard",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "reset-password": "node dist/cli.js reset-password",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.3.3",
    "node-ical": "^0.20.1",
    "otpauth": "^9.4.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.2",
    "tsdav": "^2.1.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
