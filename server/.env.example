# Configuration du serveur Smart Dashboard.
# Copie ce fichier en « .env » (même dossier) puis adapte les valeurs.
# Sur le VPS, deploy/install.sh le crée pour toi.

# Adresse publique de la console (sert aussi pour l'URL de retour Spotify)
PUBLIC_URL=https://dashboard.mon-domaine.fr

# Clé de chiffrement des clés d'API stockées (32 octets en base64).
# Génère-la avec : npm run gen-key   (ou : openssl rand -base64 32)
# Garde-la précieusement : sans elle, les secrets enregistrés sont illisibles.
SECRET_KEY=

# Écoute locale : Nginx fait le relais HTTPS vers ce port
HOST=127.0.0.1
PORT=8787

# Fuseau horaire des habitudes, réveils et de l'agenda
TZ=Europe/Paris
# Même fuseau au format POSIX pour la tablette (Europe/Paris ci-dessous)
TZ_POSIX=CET-1CEST,M3.5.0,M10.5.0/3

# Dossier de la base SQLite (par défaut : ./data)
# DATA_DIR=/var/lib/smart-dashboard

NODE_ENV=production
LOG_LEVEL=info
